+// NormalizeVolumePruneFilters adjusts the filters passed to a volume prune so
+// that, like Docker, a prune without "all" removes only anonymous unused
+// volumes while "all=true" also removes named ones. Any other explicit filters
+// (e.g. label, label!) are always preserved and applied on top.
+//
+//   - all=true (or "1"): drop the "all" key but keep every other filter, so all
+//     unused volumes matching those filters are pruned.
+//   - other explicit filters without "all": forward them unchanged.
+//   - no filters at all: add anonymous=true so named volumes are preserved.
+func NormalizeVolumePruneFilters(f url.Values) url.Values {
+	if len(f) == 0 {
+		f = make(url.Values)
+	}
+	allValue := f.Get("all")
+	allSet := strings.EqualFold(allValue, "true") || allValue == "1"
+	f.Del("all")
+
+	if allSet || len(f) > 0 {
+		return f
+	}
+	f.Set("anonymous", "true")
+	return f
+}
